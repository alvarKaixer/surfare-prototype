# Server-side Vercel variable: set it in the Vercel dashboard.
# Never prefix with VITE_ or expose it in browser code.
GOOGLE_SAFE_BROWSING_API_KEY=
# Optional contextual AI. Auto selects OpenRouter when its key is present, otherwise Gemini.
AI_PROVIDER=auto
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional Gemini alternative; selected with AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
