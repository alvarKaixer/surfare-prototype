{
  "name": "surfare-detector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --local",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "npm run check:secrets && node scripts/copy-ocr.mjs && tsc --noEmit && vite build && node scripts/offline.mjs && node scripts/check-build.mjs",
    "check": "npm run format:check && npm test && npm run build",
    "check:secrets": "node scripts/check-secrets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "validation:report": "node research/scripts/generate-validation.mjs",
    "validation:ai": "node research/scripts/check-ai.mjs --report",
    "model:train": "python research/scripts/prepare-sms-data.py && node research/scripts/train-sms-model.mjs",
    "model:evaluate": "node research/scripts/evaluate-detector.mjs --test",
    "preview": "wrangler dev --local",
    "deploy:cloudflare": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "jsqr": "1.4.0",
    "lucide-react": "^1.31.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "6.0.1",
    "tldts": "7.4.19",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "workbox-build": "7.4.1",
    "wrangler": "4.156.0"
  }
}
