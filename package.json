{
  "name": "surfare-detector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --local",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "node scripts/copy-ocr.mjs && tsc --noEmit && vite build && node scripts/offline.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "wrangler dev --local",
    "deploy:cloudflare": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@techstark/opencv-js": "4.11.0-release.1",
    "@tesseract.js-data/eng": "1.0.0",
    "jsqr": "1.4.0",
    "lucide-react": "^1.31.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "6.0.1",
    "tldts": "7.4.19",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "workbox-build": "7.4.1",
    "wrangler": "4.156.0"
  }
}
